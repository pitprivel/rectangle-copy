{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Rectangle Copy",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Rectangle Copy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": false
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab"
  ],
  "homepage_url": "https://github.com/pitprivel/rectangle-copy"
}
